# Copiez ce fichier en `.env` et remplissez le token de votre bot.
# Le token s'obtient sur https://discord.com/developers/applications
DISCORD_TOKEN=votre_token_ici

# Optionnel : ID du serveur (guild) pour synchroniser les commandes instantanément
# pendant le développement. Laissez vide pour une synchro globale (peut prendre ~1h).
GUILD_ID=
