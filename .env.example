# Copiez ce fichier en `.env` puis renseignez votre token de bot Discord.
# Le token s'obtient sur https://discord.com/developers/applications
DISCORD_TOKEN=votre_token_ici

# Optionnel : ID d'un serveur pour synchroniser les commandes instantanément
# (utile en développement, sinon la sync globale peut prendre ~1h)
GUILD_ID=
